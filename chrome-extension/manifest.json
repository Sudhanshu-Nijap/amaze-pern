{
  "manifest_version": 3,
  "name": "Amaze Price Tracker",
  "version": "1.0",
  "description": "Instantly track Amazon prices and view historical trends with Amaze.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*"
  ]
}
